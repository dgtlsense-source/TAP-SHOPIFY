<section id="lab" class="border-b border-border bg-card">
  <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-10 px-4 py-16 sm:gap-12 sm:px-6 sm:py-20 md:grid-cols-12 lg:py-28">
    
    <!-- Title Column -->
    <div class="md:col-span-4">
      <span class="ticker-label">{{ section.settings.label }}</span>
    </div>
    
    <!-- Copy Column -->
    <div class="md:col-span-8 space-y-8">
      <p class="font-display text-2xl uppercase font-bold tracking-tight leading-[1.05] sm:text-3xl md:text-5xl">
        {{ section.settings.headline }}
      </p>
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        {{ section.settings.description }}
      </p>
      
      <!-- Certification grid -->
      <div class="grid grid-cols-1 gap-px bg-border border border-border sm:grid-cols-3">
        {%- for block in section.blocks -%}
          <div class="bg-background p-4 sm:p-5" {{ block.shopify_attributes }}>
            <div class="font-display text-lg font-bold uppercase tracking-tight sm:text-xl">
              {{ block.settings.title }}
            </div>
            <div class="ticker-label mt-1">
              {{ block.settings.value }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "Brand Purpose",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "§ 04 / Brand Purpose"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Section Headline",
      "default": "To enlighten the world with a deeper understanding of what they wear — bringing clarity, transparency, and sophistication to every fragrance experience."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Through meticulously crafted formulas, we create scents that feel indulgent, empowering, and profoundly personal — elevating confidence with every spray. Our fragrances are <strong class=\"text-foreground\">phthalate-free, toxin-free, and cruelty-free</strong>, created with respect for skin, life, and Mother Earth."
    }
  ],
  "blocks": [
    {
      "type": "cert_item",
      "name": "Certification Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title",
          "default": "Phthalate-free"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Badge Description",
          "default": "Skin-safe formulation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Purpose",
      "blocks": [
        {
          "type": "cert_item",
          "settings": { "title": "Phthalate-free", "value": "Skin-safe formulation" }
        },
        {
          "type": "cert_item",
          "settings": { "title": "Toxin-free", "value": "Tested & verified" }
        },
        {
          "type": "cert_item",
          "settings": { "title": "Cruelty-free", "value": "Never on animals" }
        }
      ]
    }
  ]
}
{% endschema %}
