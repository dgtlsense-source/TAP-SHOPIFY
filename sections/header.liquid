<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-3">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: height: 60 }}" alt="{{ shop.name }}" class="h-7 w-auto md:h-8" style="object-fit: contain;">
      {%- else -%}
        <img src="{{ 'logo-v5.svg' | asset_url }}" alt="T.A.P — The Aroma Project" class="h-7 w-auto md:h-8">
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden gap-8 md:flex">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="mono text-[11px] tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- else -%}
        <a href="#catalogue" class="mono text-[11px] tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Catalogue</a>
        <a href="#scent-finder" class="mono text-[11px] tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Scent Finder</a>
        <a href="#sourcing" class="mono text-[11px] tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Sourcing</a>
        <a href="#editorial" class="mono text-[11px] tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Reviews</a>
        <a href="#faq" class="mono text-[11px] tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">FAQ</a>
      {%- endif -%}
    </nav>

    <div class="flex items-center gap-3">
      <!-- Cart Link -->
      <a href="{{ routes.cart_url }}" class="mono inline-flex shrink-0 items-center border border-foreground bg-foreground px-3 py-2 text-[10px] uppercase tracking-[0.2em] text-background transition hover:bg-background hover:text-foreground sm:px-4 sm:py-2.5 sm:text-[11px] sm:tracking-[0.25em]">
        {{ section.settings.button_text | default: 'Acquire ↗' }}
        {%- if cart.item_count > 0 -%}
          <span class="ml-1.5 font-sans">({{ cart.item_count }})</span>
        {%- endif -%}
      </a>

      <!-- Mobile Hamburger Button -->
      <button id="MobileMenuBtn" class="flex h-8 w-8 items-center justify-center border border-border md:hidden" aria-label="Open Menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="MobileMenuOverlay" class="fixed inset-0 top-[53px] z-50 hidden bg-background/95 backdrop-blur md:hidden">
    <nav class="flex flex-col gap-6 p-6">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="MobileNavLink mono text-xs tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- else -%}
        <a href="#catalogue" class="MobileNavLink mono text-xs tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Catalogue</a>
        <a href="#scent-finder" class="MobileNavLink mono text-xs tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Scent Finder</a>
        <a href="#sourcing" class="MobileNavLink mono text-xs tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Sourcing</a>
        <a href="#editorial" class="MobileNavLink mono text-xs tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">Reviews</a>
        <a href="#faq" class="MobileNavLink mono text-xs tracking-[0.25em] uppercase text-muted-foreground transition hover:text-foreground">FAQ</a>
      {%- endif -%}
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuBtn = document.getElementById('MobileMenuBtn');
    const mobileMenuOverlay = document.getElementById('MobileMenuOverlay');
    const mobileNavLinks = document.querySelectorAll('.MobileNavLink');

    if (mobileMenuBtn && mobileMenuOverlay) {
      mobileMenuBtn.addEventListener('click', function() {
        const isHidden = mobileMenuOverlay.classList.contains('hidden');
        if (isHidden) {
          mobileMenuOverlay.classList.remove('hidden');
          mobileMenuBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          `;
        } else {
          mobileMenuOverlay.classList.add('hidden');
          mobileMenuBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          `;
        }
      });
    }

    mobileNavLinks.forEach(link => {
      link.addEventListener('click', function() {
        if (mobileMenuOverlay) {
          mobileMenuOverlay.classList.add('hidden');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo",
      "info": "Upload custom brand logo. Default is logo-v5.svg"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "info": "Select main menu. Falls back to default anchor links if empty."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Acquire ↗"
    }
  ]
}
{% endschema %}
