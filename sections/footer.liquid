<footer class="bg-background border-t border-border mt-auto">
  <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-5 lg:gap-10">
      
      <!-- Column 1: Info & Brand (Span 2 on tablet & desktop) -->
      <div class="space-y-5 sm:col-span-2">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: height: 60 }}" alt="{{ shop.name }}" class="h-8 w-auto" style="object-fit: contain;">
        {%- else -%}
          <a href="{{ routes.root_url }}" class="inline-block border border-border px-2.5 py-1 mono text-xs font-bold tracking-[0.2em] text-foreground hover:border-foreground transition">
            T.A.P
          </a>
        {%- endif -%}
        
        <p class="max-w-xs text-xs sm:text-sm text-muted-foreground leading-relaxed">
          {{ section.settings.description | default: 'The Aroma Project — a modern perfumery lab.<br>Engineered for modern everyday rituals.' }}
        </p>
        
        <div class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground pt-1">
          {{ section.settings.certifications | default: 'PHTHALATE-FREE · TOXIN-FREE · CRUELTY-FREE' }}
        </div>
      </div>

      <!-- Column 2: Catalogue -->
      <div class="space-y-3">
        <div class="ticker-label">{{ section.settings.col_1_title | default: 'CATALOGUE' }}</div>
        {%- if section.settings.col_1_menu != blank -%}
          {%- for link in section.settings.col_1_menu.links -%}
            <a href="{{ link.url }}" class="mono block text-xs uppercase tracking-[0.15em] text-foreground transition hover:text-muted-foreground">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="#catalogue" class="mono block text-xs uppercase tracking-[0.15em] hover:text-muted-foreground transition">TAP-01 — MANGO 12</a>
          <a href="#catalogue" class="mono block text-xs uppercase tracking-[0.15em] hover:text-muted-foreground transition">TAP-02 — SAMBAC 8</a>
          <a href="#catalogue" class="mono block text-xs uppercase tracking-[0.15em] hover:text-muted-foreground transition">TAP-03 — VETIVER 16</a>
          <a href="#catalogue" class="mono block text-xs uppercase tracking-[0.15em] hover:text-muted-foreground transition">TAP-04 — BERGAMOTE 10</a>
          <a href="#catalogue" class="mono block text-xs uppercase tracking-[0.15em] hover:text-muted-foreground transition">TAP-05 — SPICE 21</a>
        {%- endif -%}
      </div>

      <!-- Column 3: Lab Links -->
      <div class="space-y-3">
        <div class="ticker-label">{{ section.settings.col_2_title | default: 'LAB' }}</div>
        {%- if section.settings.col_2_menu != blank -%}
          {%- for link in section.settings.col_2_menu.links -%}
            <a href="{{ link.url }}" class="mono block text-xs uppercase tracking-[0.15em] text-foreground transition hover:text-muted-foreground">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="#story" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">OUR STORY</a>
          <a href="#sourcing" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">SOURCING</a>
          <a href="#lab" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">BRAND PURPOSE</a>
          <a href="#faq" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">FAQ</a>
          <a href="{{ routes.cart_url }}" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">CHECKOUT</a>
        {%- endif -%}
      </div>

      <!-- Column 4: Contact -->
      <div class="space-y-3">
        <div class="ticker-label">{{ section.settings.col_3_title | default: 'CONTACT' }}</div>
        <div class="mono text-xs">
          <a href="mailto:{{ section.settings.contact_email | default: 'admin@thearomaproject.com' }}" class="hover:underline">
            {{ section.settings.contact_email | default: 'admin@thearomaproject.com' }}
          </a>
        </div>
        <div class="mono text-xs">
          <a href="{{ section.settings.contact_website_url | default: 'https://www.thearomaproject.com' }}" class="hover:underline" target="_blank" rel="noreferrer">
            {{ section.settings.contact_website | default: 'www.thearomaproject.com' }}
          </a>
        </div>
        <div class="mono text-xs leading-relaxed text-muted-foreground pt-1">
          {{ section.settings.contact_address | default: 'Zion, 1803 Sindhu Bhavan<br>Ahmedabad, India' }}
        </div>
      </div>

    </div>

    <!-- Bottom copyright row -->
    <div class="hairline mt-12 flex flex-col justify-between gap-3 pt-6 mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground sm:flex-row">
      <span>{{ section.settings.copyright_text | default: '© 2026 THE AROMA PROJECT' }}</span>
      <span>{{ section.settings.bottom_signature | default: 'ALL FORMULAS PROPRIETARY · ENGINEERED IN INDIA' }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Company Info"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Footer Logo"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Footer Description",
      "default": "The Aroma Project — a modern perfumery lab.<br>Engineered for modern everyday rituals."
    },
    {
      "type": "text",
      "id": "certifications",
      "label": "Certifications Badges",
      "default": "PHTHALATE-FREE · TOXIN-FREE · CRUELTY-FREE"
    },
    {
      "type": "header",
      "content": "Columns Configuration"
    },
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 Title",
      "default": "CATALOGUE"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 Menu (Optional)"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 Title",
      "default": "LAB"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 Menu (Optional)"
    },
    {
      "type": "text",
      "id": "col_3_title",
      "label": "Column 3 Title",
      "default": "CONTACT"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "admin@thearomaproject.com"
    },
    {
      "type": "text",
      "id": "contact_website",
      "label": "Website Display Text",
      "default": "www.thearomaproject.com"
    },
    {
      "type": "url",
      "id": "contact_website_url",
      "label": "Website Link URL"
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Address Text",
      "default": "Zion, 1803 Sindhu Bhavan<br>Ahmedabad, India"
    },
    {
      "type": "header",
      "content": "Bottom Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Bottom Copyright Text",
      "default": "© 2026 THE AROMA PROJECT"
    },
    {
      "type": "text",
      "id": "bottom_signature",
      "label": "Bottom Signature",
      "default": "ALL FORMULAS PROPRIETARY · ENGINEERED IN INDIA"
    }
  ]
}
{% endschema %}
