<div class="overflow-hidden border-b border-border bg-foreground text-background" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}{% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}">
  <div class="flex gap-12 whitespace-nowrap py-4 mono text-[11px] tracking-[0.35em] uppercase" style="animation: marquee {{ section.settings.speed }}s linear infinite;">
    <!-- Loop 3 times to ensure infinite scroll fills space -->
    {%- for i in (1..3) -%}
      {%- for block in section.blocks -%}
        <span class="flex items-center gap-12" {{ block.shopify_attributes }}>
          {{ block.settings.text }} <span class="opacity-40">◆</span>
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
</style>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Scroll Duration (Seconds)",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Ticker Text",
          "default": "PRECISION"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "word", "settings": { "text": "PRECISION" } },
        { "type": "word", "settings": { "text": "ORIGIN" } },
        { "type": "word", "settings": { "text": "RAWNESS" } },
        { "type": "word", "settings": { "text": "CONTROL" } },
        { "type": "word", "settings": { "text": "DISTINCTION" } }
      ]
    }
  ]
}
{% endschema %}
