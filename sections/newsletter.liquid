<section id="contact" class="border-b border-border bg-foreground text-background">
  <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-8 px-4 py-16 sm:gap-10 sm:px-6 sm:py-20 md:grid-cols-12">
    
    <!-- Left Column: Title & Text (Takes 6 of 12 columns) -->
    <div class="md:col-span-6 space-y-4">
      <span class="mono text-[10px] uppercase tracking-[0.25em] text-background/60">
        {{ section.settings.label | default: '§ 07 / LAB NOTES' }}
      </span>
      <h2 class="font-display text-4xl font-bold uppercase tracking-tight sm:text-5xl md:text-7xl leading-[0.92]">
        {{ section.settings.headline | default: 'DISPATCHES<br />FROM THE BENCH.' }}
      </h2>
      <p class="max-w-md text-sm text-background/70 leading-relaxed sm:text-base">
        {{ section.settings.description | default: 'Formulation diaries, raw material studies, and early access to upcoming batches. Sent only when there is something to say.' }}
      </p>
    </div>
    
    <!-- Right Column: Form (Takes 6 of 12 columns, aligned cleanly at bottom) -->
    <div class="md:col-span-6 flex flex-col justify-end" style="align-self: flex-end;">
      {%- form 'customer', class: 'flex flex-col sm:flex-row justify-end gap-3 w-full' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        {%- if form.posted_successfully? -%}
          <div class="mono text-xs text-background/90 py-3 border border-background/20 px-4 bg-background/5 w-full">
            ✓ Thank you for subscribing.
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="mono text-xs text-red-400 pb-2 w-full">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}
          
          <input
            type="email"
            name="contact[email]"
            id="NewsletterForm-{{ section.id }}"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder | default: 'you@domain.com' }}"
            class="mono flex-1 border border-background/30 bg-transparent px-4 py-3 text-sm text-background placeholder:text-background/40 focus:border-background focus:outline-none"
            style="height: 48px; min-height: 48px; max-height: 48px; box-sizing: border-box;"
            required
          >
          
          <button
            type="submit"
            class="mono shrink-0 border border-background bg-background px-6 py-3 text-[11px] uppercase tracking-[0.25em] text-foreground transition hover:bg-transparent hover:text-background flex items-center justify-center font-medium"
            style="height: 48px; min-height: 48px; max-height: 48px; box-sizing: border-box; white-space: nowrap;"
          >
            {{ section.settings.button_text | default: 'SUBSCRIBE >' }}
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "§ 07 / LAB NOTES"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Section Headline",
      "default": "DISPATCHES<br />FROM THE BENCH."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Formulation diaries, raw material studies, and early access to upcoming batches. Sent only when there is something to say."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "you@domain.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SUBSCRIBE >"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
