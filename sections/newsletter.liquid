<section id="contact" class="border-b border-border bg-foreground text-background">
  <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-8 px-4 py-12 sm:gap-10 sm:px-6 sm:py-16 md:grid-cols-12 md:items-end">
    
    <!-- Text Info -->
    <div class="md:col-span-7 space-y-4">
      <span class="mono text-[10px] uppercase tracking-[0.25em] text-background/60">
        {{ section.settings.label | default: '§ 07 / LAB NOTES' }}
      </span>
      <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight leading-[0.92]">
        {{ section.settings.headline | default: 'DISPATCHES<br />FROM THE BENCH.' }}
      </h2>
      <p class="max-w-md text-xs sm:text-sm text-background/70 leading-relaxed">
        {{ section.settings.description | default: 'Formulation diaries, raw material studies, and early access to upcoming batches. Sent only when there is something to say.' }}
      </p>
    </div>
    
    <!-- Shopify Customer Newsletter Form -->
    <div class="md:col-span-5 w-full">
      {%- form 'customer', class: 'w-full' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        {%- if form.posted_successfully? -%}
          <div class="mono text-xs text-background/90 py-3 border border-background/20 px-4 bg-background/5">
            ✓ Thank you for subscribing. You are on the list.
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="mono text-xs text-red-400 pb-2">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}
          
          <div class="flex flex-col sm:flex-row items-stretch border border-background/30 focus-within:border-background transition-colors w-full">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterForm-{{ section.id }}"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder | default: 'you@domain.com' }}"
              class="mono flex-1 bg-transparent px-4 py-3 text-xs sm:text-sm text-background placeholder:text-background/40 focus:outline-none h-11 sm:h-12 border-0"
              required
            >
            <button
              type="submit"
              class="mono bg-background text-foreground px-5 sm:px-6 py-3 text-[10px] sm:text-[11px] uppercase tracking-[0.2em] font-medium transition hover:bg-background/90 shrink-0 h-11 sm:h-12 flex items-center justify-center border-t sm:border-t-0 sm:border-l border-background/30"
            >
              {{ section.settings.button_text | default: 'SUBSCRIBE ↗' }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "§ 07 / LAB NOTES"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Section Headline",
      "default": "DISPATCHES<br />FROM THE BENCH."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Formulation diaries, raw material studies, and early access to upcoming batches. Sent only when there is something to say."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "you@domain.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SUBSCRIBE ↗"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
