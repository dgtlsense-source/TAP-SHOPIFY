<div class="bg-foreground text-background" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}{% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-4 py-1.5 mono text-[9px] tracking-[0.2em] uppercase sm:px-6 sm:text-[10px] sm:tracking-[0.25em]">
    <span class="truncate">{{ section.settings.text_left }}</span>
    <span class="hidden md:inline">{{ section.settings.text_center }}</span>
    <span class="shrink-0">{{ section.settings.text_right }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text_left",
      "label": "Left Text",
      "default": "Batch 0001 — Shipping"
    },
    {
      "type": "text",
      "id": "text_center",
      "label": "Center Text",
      "default": "Phthalate-free · Cruelty-free · Made in India"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "Right Text",
      "default": "Free Ship > Rs.2,500"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    }
  ]
}
{% endschema %}
