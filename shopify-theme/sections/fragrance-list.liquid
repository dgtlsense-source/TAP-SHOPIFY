<section id="catalogue" class="border-b border-border bg-card">
  <div class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 sm:py-20 lg:py-28">
    
    <!-- Section Header -->
    <div class="mb-10 flex flex-col items-start justify-between gap-4 border-b border-border pb-6 sm:mb-12 sm:flex-row sm:items-end sm:gap-6">
      <div class="min-w-0 space-y-3">
        <span class="ticker-label">{{ section.settings.label }}</span>
        <h2 class="font-display text-4xl tracking-tight font-bold uppercase sm:text-5xl md:text-7xl">
          {{ section.settings.title }}
        </h2>
      </div>
      <span class="mono hidden text-[11px] uppercase tracking-[0.25em] text-muted-foreground md:inline">
        {{ section.settings.subtitle }}
      </span>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {%- for block in section.blocks -%}
        <article class="group relative flex flex-col bg-background p-5 transition hover:bg-card" {{ block.shopify_attributes }}>
          
          <!-- Header -->
          <div class="flex items-start justify-between">
            <span class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
              {{ block.settings.code }}
            </span>
            <span class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
              № 0{{ forloop.index }} / 05
            </span>
          </div>

          <!-- Image -->
          <div class="my-6 flex aspect-[3/4] items-center justify-center overflow-hidden bg-muted bg-grid border border-border/10">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="T.A.P {{ block.settings.name }}"
                class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]"
                loading="lazy"
              >
            {%- if forloop.index == 2 -%}
                <img
                  src="{{ 'sambac-8.jpg' | asset_url }}"
                  alt="T.A.P {{ block.settings.name }}"
                  class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                >
              {%- elif forloop.index == 3 -%}
                <img
                  src="{{ 'vetiver-16.jpg' | asset_url }}"
                  alt="T.A.P {{ block.settings.name }}"
                  class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                >
              {%- elif forloop.index == 4 -%}
                <img
                  src="{{ 'bergamote-10.jpg' | asset_url }}"
                  alt="T.A.P {{ block.settings.name }}"
                  class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                >
              {%- elif forloop.index == 5 -%}
                <img
                  src="{{ 'spice-21.jpg' | asset_url }}"
                  alt="T.A.P {{ block.settings.name }}"
                  class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                >
              {%- else -%}
                <img
                  src="{{ 'mango-12.jpg' | asset_url }}"
                  alt="T.A.P {{ block.settings.name }}"
                  class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                >
              {%- endif -%}
            {%- endif -%}
          </div>

          <!-- Info -->
          <h3 class="font-display text-2xl font-bold uppercase tracking-tight">
            {{ block.settings.name }}
          </h3>
          
          <div class="mono mt-1 text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
            {{ block.settings.family }}
          </div>
          
          <div class="mono mt-0.5 text-[10px] uppercase tracking-[0.2em] text-steel">
            > {{ block.settings.origin }}
          </div>

          <!-- Notes -->
          <dl class="mt-5 space-y-1 border-t border-border pt-4 text-xs">
            <div class="ticker-label mb-2">Notes</div>
            <div class="flex gap-3 text-foreground/80">
              <dt class="mono w-6 text-muted-foreground">01</dt>
              <dd class="mono uppercase tracking-[0.18em]">{{ block.settings.note1 }}</dd>
            </div>
            <div class="flex gap-3 text-foreground/80">
              <dt class="mono w-6 text-muted-foreground">02</dt>
              <dd class="mono uppercase tracking-[0.18em]">{{ block.settings.note2 }}</dd>
            </div>
            <div class="flex gap-3 text-foreground/80">
              <dt class="mono w-6 text-muted-foreground">03</dt>
              <dd class="mono uppercase tracking-[0.18em]">{{ block.settings.note3 }}</dd>
            </div>
          </dl>

          <!-- Price / Volume -->
          <div class="mt-5 flex items-end justify-between border-t border-border pt-4">
            <div>
              <div class="ticker-label">Vol</div>
              <div class="mono mt-1 text-xs">{{ block.settings.volume }}</div>
            </div>
            <div class="text-right">
              <div class="ticker-label">Price</div>
              <div class="font-display mt-0.5 text-xl font-bold">{{ block.settings.price }}</div>
            </div>
          </div>

          <!-- Add to Cart Form (via Variant ID) or external link -->
          {%- if block.settings.variant_id != blank -%}
            <form method="post" action="/cart/add" class="mt-4">
              <input type="hidden" name="id" value="{{ block.settings.variant_id }}">
              <button
                type="submit"
                class="mono w-full border border-foreground bg-transparent px-4 py-3 text-center text-[10px] uppercase tracking-[0.25em] transition hover:bg-foreground hover:text-background"
              >
                {{ block.settings.button_text }}
              </button>
            </form>
          {%- else -%}
            <a
              href="/cart/add"
              class="mono mt-4 border border-foreground bg-transparent px-4 py-3 text-center text-[10px] uppercase tracking-[0.25em] transition hover:bg-foreground hover:text-background"
            >
              {{ block.settings.button_text }}
            </a>
          {%- endif -%}
          
        </article>
      {%- endfor -%}
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "Catalogue Section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "§ 02 / Catalogue"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Five compositions."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Ticker",
      "default": "TAP-01 -> TAP-05"
    }
  ],
  "blocks": [
    {
      "type": "fragrance_card",
      "name": "Fragrance Card",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Fragrance Code",
          "default": "TAP-01"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Fragrance Name",
          "default": "MANGO 12"
        },
        {
          "type": "text",
          "id": "family",
          "label": "Fragrance Family",
          "default": "TROPICAL / FRESH"
        },
        {
          "type": "text",
          "id": "origin",
          "label": "Origin Place",
          "default": "Konkan, India"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fragrance Image"
        },
        {
          "type": "text",
          "id": "note1",
          "label": "Note 1",
          "default": "Citrus"
        },
        {
          "type": "text",
          "id": "note2",
          "label": "Note 2",
          "default": "Tropical"
        },
        {
          "type": "text",
          "id": "note3",
          "label": "Note 3",
          "default": "Amber"
        },
        {
          "type": "text",
          "id": "volume",
          "label": "Volume Details",
          "default": "48 ml"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price Details",
          "default": "Rs. 999"
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Shopify Variant ID",
          "info": "Optional. Enter the numeric Shopify variant ID for direct cart additions."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Acquire ↗"
        }
      ]
    }
  ]
}
{% endschema %}
