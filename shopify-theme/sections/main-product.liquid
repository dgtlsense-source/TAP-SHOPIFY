<div class="min-h-screen bg-background text-foreground">
  <header class="border-b border-border">
    <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
      <a href="/" class="mono truncate text-[10px] tracking-[0.2em] sm:text-xs text-foreground">
        ← T.A.P / RETURN TO CATALOGUE
      </a>
      <span class="ticker-label shrink-0">COMPOSITION · STUDY</span>
    </div>
  </header>

  <div class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6 sm:py-10 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      
      <!-- Product Image -->
      <div class="flex aspect-[3/4] items-center justify-center overflow-hidden bg-muted bg-grid border border-border">
        {%- if product.featured_image != blank -%}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.title | escape }}"
            class="h-full w-full object-contain"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'h-full w-full object-contain' }}
        {%- endif -%}
      </div>

      <!-- Product Info Details -->
      <div class="flex flex-col justify-between space-y-8 lg:space-y-12">
        <div class="space-y-6">
          <div>
            <div class="flex items-center justify-between">
              <span class="mono text-[11px] uppercase tracking-[0.25em] text-muted-foreground">
                {{ product.selected_or_first_available_variant.sku | default: 'TAP-PRODUCT' }}
              </span>
              <span class="mono text-[11px] uppercase tracking-[0.25em] text-steel">
                ↳ {{ product.vendor | default: 'India' }}
              </span>
            </div>
            <h1 class="font-display mt-2 text-4xl font-bold uppercase tracking-tight sm:text-5xl lg:text-6xl">
              {{ product.title }}
            </h1>
            <div class="mono mt-2 text-xs uppercase tracking-[0.25em] text-muted-foreground">
              {{ product.type | default: 'Eau de Parfum' }}
            </div>
          </div>

          <div class="prose max-w-none text-sm leading-relaxed text-muted-foreground">
            {{ product.description }}
          </div>

          <!-- Notes -->
          {%- assign note1 = 'Citrus' -%}
          {%- assign note2 = 'Tropical' -%}{%- assign note3 = 'Amber' -%}
          {%- for tag in product.tags -%}
            {%- if tag contains 'note1:' -%}{%- assign note1 = tag | remove: 'note1:' -%}{%- endif -%}
            {%- if tag contains 'note2:' -%}{%- assign note2 = tag | remove: 'note2:' -%}{%- endif -%}
            {%- if tag contains 'note3:' -%}{%- assign note3 = tag | remove: 'note3:' -%}{%- endif -%}
          {%- endfor -%}
          <dl class="space-y-1 border-t border-border pt-6 text-xs">
            <div class="ticker-label mb-3">Fragrance Accord Accords</div>
            <div class="flex gap-4 text-foreground/80"><dt class="mono w-6 text-muted-foreground">01</dt><dd class="mono uppercase tracking-[0.18em]">{{ note1 }}</dd></div>
            <div class="flex gap-4 text-foreground/80"><dt class="mono w-6 text-muted-foreground">02</dt><dd class="mono uppercase tracking-[0.18em]">{{ note2 }}</dd></div>
            <div class="flex gap-4 text-foreground/80"><dt class="mono w-6 text-muted-foreground">03</dt><dd class="mono uppercase tracking-[0.18em]">{{ note3 }}</dd></div>
          </dl>
        </div>

        <div class="border-t border-border pt-6 space-y-6">
          <div class="flex items-baseline justify-between">
            <div>
              <div class="ticker-label">Vol</div>
              <div class="mono mt-1 text-xs">48 ml · 1.62 fl.oz</div>
            </div>
            <div class="text-right">
              <div class="ticker-label">Price</div>
              <div class="font-display mt-0.5 text-2xl font-bold">{{ product.price | money }}</div>
            </div>
          </div>

          <!-- Form / Buy -->
          <form method="post" action="/cart/add" class="w-full">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            
            <div class="flex gap-3">
              <!-- Quantity Stepper -->
              <div class="flex items-center border border-border bg-background">
                <button type="button" onclick="this.parentNode.querySelector('input').stepDown()" class="h-12 w-12 text-sm hover:bg-muted" aria-label="Decrease">−</button>
                <input type="number" name="quantity" value="1" min="1" max="9" class="mono w-10 text-center text-xs bg-transparent border-0 outline-none p-0" style="-moz-appearance: textfield;">
                <button type="button" onclick="this.parentNode.querySelector('input').stepUp()" class="h-12 w-12 text-sm hover:bg-muted" aria-label="Increase">+</button>
              </div>

              <button
                type="submit"
                class="flex-1 border border-foreground bg-foreground py-4 text-xs tracking-[0.25em] text-background transition hover:bg-transparent hover:text-foreground disabled:opacity-30 disabled:cursor-not-allowed"
                {% unless product.available %}disabled{% endunless %}
              >
                {% if product.available %}ACQUIRE NOW ->{% else %}SOLD OUT{% endif %}
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
