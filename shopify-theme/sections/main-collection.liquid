<div class="min-h-screen bg-background text-foreground">
  <header class="border-b border-border">
    <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
      <a href="/" class="mono truncate text-[10px] tracking-[0.2em] sm:text-xs text-foreground">
        ← T.A.P / RETURN TO CATALOGUE
      </a>
      <span class="ticker-label shrink-0">{{ collection.title | uppercase }}</span>
    </div>
  </header>

  <div class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6 sm:py-10 lg:py-16">
    <div class="mb-10 border-b border-border pb-6">
      <p class="ticker-label">§ Collection</p>
      <h1 class="font-display mt-3 text-4xl font-bold uppercase tracking-tight sm:text-5xl lg:text-6xl">
        {{ collection.title }}
      </h1>
      {%- if collection.description != blank -%}
        <p class="mt-2 text-sm text-muted-foreground max-w-xl">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {%- for product in collection.products -%}
        <article class="group relative flex flex-col bg-background p-5 transition hover:bg-card">
          <div class="flex items-start justify-between">
            <span class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
              {{ product.selected_or_first_available_variant.sku | default: 'TAP-PRODUCT' }}
            </span>
            <span class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
              № 0{{ forloop.index }} / 05
            </span>
          </div>

          <a href="{{ product.url }}" class="my-6 flex aspect-[3/4] items-center justify-center overflow-hidden bg-muted bg-grid">
            {%- if product.featured_image != blank -%}
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'h-full w-full object-contain transition duration-500 group-hover:scale-[1.04]' }}
            {%- endif -%}
          </a>

          <h3 class="font-display text-2xl font-bold uppercase tracking-tight">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          <div class="mono mt-1 text-[10px] uppercase tracking-[0.25em] text-muted-foreground">{{ product.type | default: 'Fragrance' }}</div>
          <div class="mono mt-0.5 text-[10px] uppercase tracking-[0.2em] text-steel">↳ {{ product.vendor }}</div>

          <div class="mt-auto pt-6">
            <div class="flex items-end justify-between border-t border-border pt-4">
              <div><div class="ticker-label">Vol</div><div class="mono mt-1 text-xs">48 ml</div></div>
              <div class="text-right"><div class="ticker-label">Price</div><div class="font-display mt-0.5 text-xl font-bold">{{ product.price | money }}</div></div>
            </div>
            <form method="post" action="/cart/add" class="mt-4">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="mono w-full border border-foreground bg-transparent px-4 py-3 text-center text-[10px] uppercase tracking-[0.25em] transition hover:bg-foreground hover:text-background" {% unless product.available %}disabled{% endunless %}>
                {% if product.available %}Acquire ↗{% else %}Sold Out{% endif %}
              </button>
            </form>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
