<footer class="bg-background border-t border-border mt-auto">
  <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid grid-cols-2 gap-8 sm:gap-10 md:grid-cols-5">
      <!-- Info Column -->
      <div class="col-span-2 space-y-5">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: height: 60 }}" alt="{{ shop.name }}" class="h-8 w-auto" style="object-fit: contain;">
        {%- else -%}
          <img src="{{ 'logo-v5.svg' | asset_url }}" alt="T.A.P" class="h-8 w-auto">
        {%- endif -%}
        
        <p class="max-w-xs text-sm text-muted-foreground">
          {{ section.settings.description | default: 'The Aroma Project — a modern perfumery lab. Engineered for modern everyday rituals.' }}
        </p>
        <div class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
          {{ section.settings.certifications | default: 'Phthalate-free · Toxin-free · Cruelty-free' }}
        </div>
      </div>

      <!-- Column 1 (Catalogue / Products) -->
      <div class="space-y-3">
        <div class="ticker-label">{{ section.settings.col_1_title | default: 'Catalogue' }}</div>
        {%- if section.settings.col_1_menu != blank -%}
          {%- for link in section.settings.col_1_menu.links -%}
            <a href="{{ link.url }}" class="mono block text-xs uppercase tracking-[0.15em] text-foreground transition hover:text-muted-foreground">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <div class="mono text-xs uppercase tracking-[0.15em]">TAP-01 — MANGO 12</div>
          <div class="mono text-xs uppercase tracking-[0.15em]">TAP-02 — SAMBAC 8</div>
          <div class="mono text-xs uppercase tracking-[0.15em]">TAP-03 — VETIVER 16</div>
          <div class="mono text-xs uppercase tracking-[0.15em]">TAP-04 — BERGAMOTE 10</div>
          <div class="mono text-xs uppercase tracking-[0.15em]">TAP-05 — SPICE 21</div>
        {%- endif -%}
      </div>

      <!-- Column 2 (Lab / Story) -->
      <div class="space-y-3">
        <div class="ticker-label">{{ section.settings.col_2_title | default: 'Lab' }}</div>
        {%- if section.settings.col_2_menu != blank -%}
          {%- for link in section.settings.col_2_menu.links -%}
            <a href="{{ link.url }}" class="mono block text-xs uppercase tracking-[0.15em] text-foreground transition hover:text-muted-foreground">
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="#story" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">Our Story</a>
          <a href="#sourcing" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">Sourcing</a>
          <a href="#lab" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">Brand Purpose</a>
          <a href="/cart" class="mono block text-xs uppercase tracking-[0.15em] transition hover:text-muted-foreground">Checkout</a>
        {%- endif -%}
      </div>

      <!-- Column 3 (Contact / Location) -->
      <div class="space-y-3">
        <div class="ticker-label">{{ section.settings.col_3_title | default: 'Contact' }}</div>
        <div class="mono text-xs">{{ section.settings.contact_email | default: 'admin@thearomaproject.com' }}</div>
        <div class="mono text-xs">{{ section.settings.contact_website | default: 'www.thearomaproject.com' }}</div>
        <div class="mono text-xs leading-relaxed text-muted-foreground">
          {{ section.settings.contact_address | default: 'Zion, 1803 Sindhu Bhawan<br>Ahmedabad, India' }}
        </div>
      </div>
    </div>

    <!-- Bottom copyright row -->
    <div class="hairline mt-12 flex flex-col justify-between gap-3 pt-6 mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground sm:flex-row">
      <span>{{ section.settings.copyright_text | default: '© 2026 The Aroma Project' }}</span>
      <span>{{ section.settings.bottom_signature | default: 'All formulas proprietary · Engineered in India' }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Company Info"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Footer Logo"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Footer Description",
      "default": "The Aroma Project — a modern perfumery lab. Engineered for modern everyday rituals."
    },
    {
      "type": "text",
      "id": "certifications",
      "label": "Certifications / Badges Text",
      "default": "Phthalate-free · Toxin-free · Cruelty-free"
    },
    {
      "type": "header",
      "content": "Catalogue Navigation"
    },
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 Title",
      "default": "Catalogue"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 Menu"
    },
    {
      "type": "header",
      "content": "Lab Navigation"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 Title",
      "default": "Lab"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 Menu"
    },
    {
      "type": "header",
      "content": "Contact Info"
    },
    {
      "type": "text",
      "id": "col_3_title",
      "label": "Column 3 Title",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "admin@thearomaproject.com"
    },
    {
      "type": "text",
      "id": "contact_website",
      "label": "Website Domain",
      "default": "www.thearomaproject.com"
    },
    {
      "type": "html",
      "id": "contact_address",
      "label": "Address (HTML)",
      "default": "Zion, 1803 Sindhu Bhawan<br>Ahmedabad, India"
    },
    {
      "type": "header",
      "content": "Copyright Row"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 The Aroma Project"
    },
    {
      "type": "text",
      "id": "bottom_signature",
      "label": "Signature Text",
      "default": "All formulas proprietary · Engineered in India"
    }
  ]
}
{% endschema %}
