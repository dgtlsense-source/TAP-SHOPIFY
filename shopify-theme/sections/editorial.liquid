<section class="relative border-b border-border bg-[#0d0d0d] text-background">
  <div class="mx-auto grid max-w-[1400px] grid-cols-1 lg:grid-cols-12">
    
    <!-- Image Column -->
    <div class="lg:col-span-7 relative">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.alt_text | escape }}" class="h-64 w-full object-cover sm:h-80 lg:h-full">
      {%- else -%}
        <img src="{{ 'collection.png' | asset_url }}" alt="T.A.P — five fragrance collection on concrete plinths with lab glassware" class="h-64 w-full object-cover sm:h-80 lg:h-full">
      {%- endif -%}
    </div>
    
    <!-- Content Column -->
    <div class="lg:col-span-5 flex flex-col justify-between gap-8 px-4 py-14 sm:px-6 sm:py-16 lg:gap-10 lg:px-12 lg:py-24">
      <div class="space-y-8">
        <span class="ticker-label text-background/60">{{ section.settings.label }}</span>
        <h2 class="font-display text-4xl font-bold uppercase tracking-tight leading-[0.92] sm:text-5xl md:text-7xl">
          {{ section.settings.headline }}
        </h2>
        <p class="max-w-md text-sm text-background/70 leading-relaxed sm:text-base">
          {{ section.settings.description }}
        </p>
      </div>
      
      <!-- List details -->
      <ul class="grid grid-cols-2 gap-x-6 gap-y-3 mono text-xs tracking-[0.2em] uppercase border-t border-background/20 pt-6">
        {%- for block in section.blocks -%}
          <li class="flex justify-between gap-4 border-b border-background/10 pb-2" {{ block.shopify_attributes }}>
            <span>{{ block.settings.title }}</span>
            <span class="text-background/50">{{ block.settings.value }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "Editorial Block",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image Alt Text",
      "default": "T.A.P — five fragrance collection on concrete plinths with lab glassware"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "§ The Collection"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline HTML",
      "default": "Raw materials.<br /><span class=\"text-background/50\">Studied.</span>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Every accord is shown as a lab material — not a decorative prop. Five formulas. One philosophy: raw ingredients, precise composition, controlled design."
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "List Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Item Name",
          "default": "MANGO 12"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Item Value",
          "default": "TAP-01"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Block",
      "blocks": [
        { "type": "list_item", "settings": { "title": "MANGO 12", "value": "TAP-01" } },
        { "type": "list_item", "settings": { "title": "SAMBAC 8", "value": "TAP-02" } },
        { "type": "list_item", "settings": { "title": "VETIVER 16", "value": "TAP-03" } },
        { "type": "list_item", "settings": { "title": "BERGAMOTE 10", "value": "TAP-04" } },
        { "type": "list_item", "settings": { "title": "SPICE 21", "value": "TAP-05" } }
      ]
    }
  ]
}
{% endschema %}
