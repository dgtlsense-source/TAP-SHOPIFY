<section id="story" class="border-b border-border">
  <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-10 px-4 py-16 sm:gap-12 sm:px-6 sm:py-20 md:grid-cols-12 lg:py-28">
    
    <!-- Title Column -->
    <div class="md:col-span-4">
      <span class="ticker-label">{{ section.settings.label }}</span>
      <h2 class="font-display mt-4 text-4xl font-bold uppercase tracking-tight leading-[0.92] sm:text-5xl md:text-6xl">
        {{ section.settings.headline }}
      </h2>
    </div>
    
    <!-- Copy Column -->
    <div class="md:col-span-8 space-y-8">
      <div class="text-xl leading-snug tracking-[-0.01em] sm:text-2xl md:text-3xl">
        {{ section.settings.highlight_text }}
      </div>
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        {{ section.settings.detail_text }}
      </p>
      
      <!-- Core Values -->
      <div class="border-t border-border pt-6">
        <div class="ticker-label mb-4">{{ section.settings.values_title }}</div>
        <div class="flex flex-wrap gap-x-5 gap-y-2 mono text-xs tracking-[0.2em] sm:text-sm">
          {%- for block in section.blocks -%}
            <span class="flex items-center gap-3" {{ block.shopify_attributes }}>
              <span class="text-muted-foreground">0{{ forloop.index }}</span>
              <span>{{ block.settings.value_text }}</span>
            </span>
          {%- endfor -%}
        </div>
      </div>
    </div>
    
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "§ 01 / Brand Story"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Section Headline",
      "default": "A LAB, NOT A BRAND."
    },
    {
      "type": "textarea",
      "id": "highlight_text",
      "label": "Highlighted text (HTML allowed)",
      "default": "T.A.P began as a small perfumery laboratory, sourcing rare accords from beautiful farmlands across the world and shaping them into <em class=\"italic text-steel\">precise modern fragrances.<\/em>"
    },
    {
      "type": "textarea",
      "id": "detail_text",
      "label": "Detail text",
      "default": "Built on transparency, we reveal the accords behind every scent so consumers can discover, understand, and choose what truly becomes their signature."
    },
    {
      "type": "text",
      "id": "values_title",
      "label": "Values Grid Title",
      "default": "Core Values"
    }
  ],
  "blocks": [
    {
      "type": "core_value",
      "name": "Core Value",
      "settings": [
        {
          "type": "text",
          "id": "value_text",
          "label": "Value",
          "default": "PRECISION"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Story",
      "blocks": [
        { "type": "core_value", "settings": { "value_text": "PRECISION" } },
        { "type": "core_value", "settings": { "value_text": "ORIGIN" } },
        { "type": "core_value", "settings": { "value_text": "RAWNESS" } },
        { "type": "core_value", "settings": { "value_text": "CONTROL" } },
        { "type": "core_value", "settings": { "value_text": "DISTINCTION" } }
      ]
    }
  ]
}
{% endschema %}
