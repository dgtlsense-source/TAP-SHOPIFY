<section class="relative w-full overflow-hidden border-b border-border">
  <video
    autoplay
    muted
    loop
    playsinline
    class="w-full object-cover"
    style="height: {{ section.settings.height_mobile }}; @media (min-width: 768px) { height: {{ section.settings.height_desktop }}; }"
  >
    {%- if section.settings.video_url != blank -%}
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    {%- else -%}
      <source src="{{ 'lab-banner.mp4' | asset_url }}" type="video/mp4">
    {%- endif -%}
    Your browser does not support the video tag.
  </video>
  
  <div class="absolute bottom-0 left-0 right-0 flex justify-between border-t border-border bg-background/80 px-6 py-2 mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground backdrop-blur">
    <span>{{ section.settings.ticker_left }}</span>
    <span>{{ section.settings.ticker_right }}</span>
  </div>
</section>

<!-- Inline styles for responsive heights -->
<style>
  #shopify-section-{{ section.id }} video {
    height: {{ section.settings.height_mobile }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} video {
      height: {{ section.settings.height_desktop }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Video Banner",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Custom Video URL",
      "info": "Upload an MP4 to Shopify Files and paste the URL here. Defaults to lab-banner.mp4."
    },
    {
      "type": "text",
      "id": "ticker_left",
      "label": "Ticker Left Text",
      "default": "Batch 0001 — Atmosphere Study"
    },
    {
      "type": "text",
      "id": "ticker_right",
      "label": "Ticker Right Text",
      "default": "Vol. 01 / 2026"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Mobile Height (px)",
      "default": 300
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Desktop Height (px)",
      "default": 550
    }
  ],
  "presets": [
    {
      "name": "Video Banner"
    }
  ]
}
{% endschema %}
