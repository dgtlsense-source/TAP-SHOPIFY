<div class="min-h-screen bg-background text-foreground">
  <header class="border-b border-border">
    <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
      <a href="/" class="mono truncate text-[10px] tracking-[0.2em] sm:text-xs text-foreground">
        ← T.A.P / RETURN TO CATALOGUE
      </a>
      <span class="ticker-label shrink-0">COLLECTIONS</span>
    </div>
  </header>

  <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-16 lg:py-24">
    <div class="mb-10 border-b border-border pb-6">
      <p class="ticker-label">§ Store Index</p>
      <h1 class="font-display mt-3 text-4xl font-bold uppercase tracking-tight sm:text-5xl lg:text-6xl">
        Collections.
      </h1>
    </div>

    <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
      {%- for collection in collections -%}
        <article class="group relative flex flex-col bg-background p-6 transition hover:bg-card">
          <span class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
            № 0{{ forloop.index }}
          </span>
          <a href="{{ collection.url }}" class="my-6 flex aspect-[16/10] items-center justify-center overflow-hidden bg-muted bg-grid border border-border">
            {%- if collection.featured_image != blank -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]' }}
            {%- endif -%}
          </a>
          <h3 class="font-display text-2xl font-bold uppercase tracking-tight">
            <a href="{{ collection.url }}">{{ collection.title }}</a>
          </h3>
          <p class="mono mt-1 text-[10px] uppercase tracking-[0.25em] text-muted-foreground">{{ collection.all_products_count }} Products</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "List Collections",
  "settings": []
}
{% endschema %}
