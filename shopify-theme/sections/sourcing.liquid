<section id="sourcing" class="border-b border-border">
  <div class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 sm:py-20 lg:py-28">
    
    <!-- Section Header -->
    <div class="mb-10 flex flex-col items-start justify-between gap-4 border-b border-border pb-6 sm:mb-12 sm:flex-row sm:items-end sm:gap-6">
      <div class="min-w-0 space-y-3">
        <span class="ticker-label">{{ section.settings.label }}</span>
        <h2 class="font-display text-4xl tracking-tight font-bold uppercase sm:text-5xl md:text-6xl">
          {{ section.settings.headline }}
        </h2>
      </div>
      <span class="mono hidden text-[11px] uppercase tracking-[0.25em] text-muted-foreground md:inline">
        {{ section.settings.subtitle }}
      </span>
    </div>

    <!-- Origins Grid -->
    <ol class="grid grid-cols-1 gap-px bg-border md:grid-cols-2 lg:grid-cols-5">
      {%- for block in section.blocks -%}
        <li class="flex flex-col gap-4 bg-background p-6" {{ block.shopify_attributes }}>
          <div class="flex items-center justify-between">
            <span class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
              Origin / 0{{ forloop.index }}
            </span>
            <span class="mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground">
              {{ block.settings.code }}
            </span>
          </div>
          <div>
            <div class="font-display text-xl font-bold uppercase tracking-tight">{{ block.settings.origin }}</div>
            <div class="ticker-label mt-1">{{ block.settings.fragrance_name }}</div>
          </div>
          <p class="text-xs leading-relaxed text-muted-foreground">
            {{ block.settings.story }}
          </p>
          <p class="mono mt-auto text-[10px] uppercase tracking-[0.18em] text-steel">
            {{ block.settings.engineered }}
          </p>
        </li>
      {%- endfor -%}
    </ol>
    
  </div>
</section>

{% schema %}
{
  "name": "Sourcing Origins",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "§ 03 / Sourcing"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline HTML",
      "default": "Real places.<br />Rare accords."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Ticker",
      "default": "5 origins · 4 countries"
    }
  ],
  "blocks": [
    {
      "type": "origin_item",
      "name": "Origin Item",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Fragrance Code",
          "default": "TAP-01"
        },
        {
          "type": "text",
          "id": "origin",
          "label": "Origin Place",
          "default": "Konkan, India"
        },
        {
          "type": "text",
          "id": "fragrance_name",
          "label": "Fragrance Name",
          "default": "MANGO 12"
        },
        {
          "type": "textarea",
          "id": "story",
          "label": "Sourcing Story",
          "default": "Mango 12 captures the essence of vibrant tropical Konkan mangoes blended with crisp citrus and warm woods."
        },
        {
          "type": "text",
          "id": "engineered",
          "label": "Engineered Purpose",
          "default": "Engineered to feel refreshing and uplifted."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sourcing Origins",
      "blocks": [
        {
          "type": "origin_item",
          "settings": {
            "code": "TAP-01",
            "origin": "Konkan, India",
            "fragrance_name": "MANGO 12",
            "story": "Mango 12 captures the essence of vibrant tropical Konkan mangoes blended with crisp citrus and warm woods.",
            "engineered": "Engineered to feel refreshing and uplifted."
          }
        },
        {
          "type": "origin_item",
          "settings": {
            "code": "TAP-02",
            "origin": "Madurai, S. India",
            "fragrance_name": "SAMBAC 8",
            "story": "Sambac 8 inherits the exceptionally intense sweet floral scent from jasmines of the Madurai region, blended with rich creamy vanilla and musk.",
            "engineered": "Engineered to feel soft and gentle."
          }
        },
        {
          "type": "origin_item",
          "settings": {
            "code": "TAP-03",
            "origin": "Les Cayes, Haiti",
            "fragrance_name": "VETIVER 16",
            "story": "Vetiver 16 envelops the earthy, damp vibes of Haitian vetiver found in Les Cayes, blended with dry woods and musk.",
            "engineered": "Engineered for a long-lasting boost."
          }
        },
        {
          "type": "origin_item",
          "settings": {
            "code": "TAP-04",
            "origin": "Reggio Calabria, Italy",
            "fragrance_name": "BERGAMOTE 10",
            "story": "Bergamote 10 brings the complex citrus freshness of bergamot from Reggio Calabria, blended with spicy woods and leather.",
            "engineered": "Engineered for deep emotional and psychological impact."
          }
        },
        {
          "type": "origin_item",
          "settings": {
            "code": "TAP-05",
            "origin": "Malabar, W. India",
            "fragrance_name": "SPICE 21",
            "story": "Spice 21 lets in the heat of Indian spices from the Malabar coast, blended with sweet, warm woods.",
            "engineered": "Engineered to boost body and mind."
          }
        }
      ]
    }
  ]
}
{% endschema %}
